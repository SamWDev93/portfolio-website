---
import IconBrandGithub from "@tabler/icons/filled/brand-github.svg";
import IconBrandLinkedin from "@tabler/icons/filled/brand-linkedin.svg";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

export interface SocialLink {
  name: string;
  href: string;
  icon: any;
}

interface Props extends HTMLAttributes<"footer"> {
  /** Array of social media links */
  socialLinks?: SocialLink[];
}

const footer1Styles = tv({
  base: "@container w-full border-t border-slate-200 dark:border-slate-800 py-8",
});

const {
  socialLinks = [
    { name: "GitHub", href: "https://github.com/SamWDev93", icon: IconBrandGithub },
    { name: "LinkedIn", href: "https://www.linkedin.com/in/sam-welsh", icon: IconBrandLinkedin }
  ],
  class: className,
  ...rest
} = Astro.props;

---

<footer class={footer1Styles({ class: className })} {...rest}>
  <div class="mx-auto w-full max-w-7xl px-4">
    <div class="flex flex-col items-center gap-4">
      <!-- Social Links -->
      <div class="flex gap-4">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-500 hover:text-accent dark:text-slate-400 dark:hover:text-accent transition-colors"
              aria-label={social.name}
            >
              <social.icon class="size-5" aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
